{
  "name": "stockiq",
  "version": "1.0.0",
  "private": true,
  "description": "StockIQ premium MERN fintech market intelligence platform",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "build": "npm run build:frontend",
    "start": "npm run start:backend",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
